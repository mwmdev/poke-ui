{
  "manifest_version": 3,
  "name": "Poke UI",
  "version": "0.1.0",
  "description": "Annotate page elements and copy the notes as markdown for your AI harness.",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/toolbar/b4432a-16.png",
    "32": "icons/toolbar/b4432a-32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle annotation mode",
    "default_icon": { "16": "icons/toolbar/b4432a-16.png", "32": "icons/toolbar/b4432a-32.png" }
  }
}
