{
  "manifest_version": 3,
  "name": "anot",
  "version": "0.1.0",
  "description": "Annotate page elements and copy the notes as markdown for your AI harness.",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle annotation mode" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
