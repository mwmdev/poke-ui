{
  "manifest_version": 3,
  "name": "Poke UI",
  "version": "0.1.0",
  "description": "Annotate page elements and copy the notes as markdown for your AI harness.",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/toolbar/e5484d-16.png",
    "32": "icons/toolbar/e5484d-32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle annotation mode",
    "default_icon": { "16": "icons/toolbar/e5484d-16.png", "32": "icons/toolbar/e5484d-32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" }
    }
  }
}
